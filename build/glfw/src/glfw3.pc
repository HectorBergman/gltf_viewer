prefix=/mnt/c/GitHub/gltf_viewer/build
exec_prefix=${prefix}
includedir=/mnt/c/GitHub/gltf_viewer/build/include
libdir=/mnt/c/GitHub/gltf_viewer/build/lib

Name: GLFW
Description: A multi-platform library for OpenGL, window and input
Version: 3.3.2
URL: https://www.glfw.org/
Requires.private:  x11
Libs: -L${libdir} -lglfw3
Libs.private:  -lrt -lm -ldl
Cflags: -I${includedir}
